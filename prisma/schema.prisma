// =============================================================================
// SCHEMA DE PRISMA - App Bodegas
// =============================================================================
// IMPORTANTE: Después de modificar este archivo, ejecuta:
//   npx prisma migrate dev --name nombre_descriptivo
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUM: Rol
// =============================================================================
enum Rol {
  ADMIN
  BODEGUERO
  CLIENTE
  REPARTIDOR
}

// =============================================================================
// MODELO: Usuario
// =============================================================================
model Usuario {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  nombre        String
  rol           Rol       @default(CLIENTE)
  bodegaId      String?   // Solo para BODEGUERO
  activo        Boolean   @default(true)
  // Rating (aplica a REPARTIDOR y BODEGUERO)
  rating        Float     @default(0)
  totalReviews  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([rol])
  @@index([bodegaId])
}

// =============================================================================
// MODELO: Producto
// =============================================================================
model Producto {
  id          String   @id
  bodegaId    String
  nombre      String
  sku         String
  categoria   String
  precio      Float
  stock       Int      @default(0)
  activo      Boolean  @default(true)
  descripcion String?
  imagenUrl   String?  // URL de imagen generada o subida
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  @@index([bodegaId])
  @@index([categoria])
  @@index([sku])
}

// =============================================================================
// MODELO: Promocion
// =============================================================================
model Promocion {
  id                  String   @id
  bodegaId            String
  nombre              String
  tipo                String   // "porcentaje" | "monto_fijo"
  valor               Float
  fechaInicio         DateTime
  fechaFin            DateTime
  aplicaA             String   // "categoria" | "producto" | "todos"
  categoriaProductos  Json     @default("[]")
  productosIds        Json     @default("[]")
  estado              String   @default("programada") // calculado dinámicamente
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([bodegaId])
  @@index([estado])
  @@index([fechaInicio, fechaFin])
}

// =============================================================================
// MODELO: Pedido
// =============================================================================
// Refleja la tabla real en la DB (migration 20260221133254)
// con campos adicionales para repartidor.
// =============================================================================
model Pedido {
  id               String   @id @default(cuid())
  bodegaId         String   @default("default")

  // Datos del cliente / entrega
  nombre           String
  telefono         String
  direccion        String
  items            Json     // array de { productoId, nombre, cantidad, precio, subtotal }
  total            Float
  estado           String   @default("confirmado")
  notas            String?

  // Repartidor asignado (opcional)
  repartidorId     String?
  repartidorNombre String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([bodegaId])
  @@index([estado])
  @@index([repartidorId])
  @@index([telefono])

  @@map("pedidos")
}

// =============================================================================
// MODELO: BodegaConfig
// =============================================================================
// Configuración de suscripción y métricas por bodega.
// Complementa el CSV maestro de bodegas.
// =============================================================================
model BodegaConfig {
  id               String    @id @default(cuid())
  bodegaId         String    @unique
  suscripcionPlan  String    @default("basico") // "basico" | "pro" | "premium"
  suscripcionVence DateTime?
  rating           Float     @default(0)
  totalReviews     Int       @default(0)
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([bodegaId])
  @@index([suscripcionPlan])
}
