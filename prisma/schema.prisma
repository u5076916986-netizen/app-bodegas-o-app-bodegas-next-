// =============================================================================
// SCHEMA DE PRISMA - App Bodegas
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUM: Rol
// =============================================================================
enum Rol {
  ADMIN
  BODEGUERO
  CLIENTE
}

// =============================================================================
// MODELO: Usuario (sistema de autenticación)
// =============================================================================
model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(CLIENTE)
  bodegaId  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([rol])
  @@index([bodegaId])
}

// =============================================================================
// MODELO: Bodega
// =============================================================================
model Bodega {
  id        String   @id @default(cuid())
  nombre    String
  estado    String   @default("activa")
  createdAt DateTime @default(now())

  @@map("bodegas")
}

// =============================================================================
// MODELO: Producto
// =============================================================================
model Producto {
  id          String   @id @default(cuid())
  bodegaId    String
  nombre      String
  sku         String?
  categoria   String?
  precio      Float
  stock       Int      @default(0)
  descripcion String?
  imagenUrl   String?
  activo      Boolean  @default(true)
  estado      String   @default("activo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([bodegaId])
  @@index([categoria])
  @@map("productos")
}

// =============================================================================
// MODELO: Pedido
// =============================================================================
model Pedido {
  id           String   @id @default(uuid())
  bodegaId     String   @default("default")
  nombre       String
  telefono     String
  direccion    String
  items        Json
  total        Float
  estado       String   @default("confirmado")
  repartidorId String?
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([bodegaId])
  @@index([estado])
  @@map("pedidos")
}

// =============================================================================
// MODELO: Tendero
// =============================================================================
model Tendero {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  nombre    String?
  createdAt DateTime @default(now())

  @@map("tenderos")
}

// =============================================================================
// MODELO: Promocion
// =============================================================================
model Promocion {
  id                  String    @id @default(uuid())
  bodegaId            String
  titulo              String
  tipo                String
  valor               Float
  descripcion         String?
  estado              String    @default("borrador")
  fechaInicio         DateTime?
  fechaFin            DateTime?
  productosAplicables Json?
  aplicaA             String?
  categoriaProductos  Json      @default("[]")
  productosIds        Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([bodegaId])
  @@index([estado])
  @@map("promociones")
}
